CREATE SCHEMA Blood_Donation_and_Transfusion_Database;
USE Blood_Donation;
CREATE TABLE Transfusion_Match(
MatchId INT PRIMARY KEY,
MatchDate Date,
RequestID INT,
CompatibilityResult ENUM('Compatible', 'Incompatible', 'Pending') NOT NULL DEFAULT 'Pending',
CONSTRAINT FK_Transfusion_Request FOREIGN KEY (RequestID) REFERENCES TransfusionRequest(RequestID),
CONSTRAINT FK_Blood_Unit FOREIGN KEY (UnitID) REFERENCES BloodUnit(RequestID) 
);

CREATE TABLE BloodBank (
BankID INT,
ContactID INT ,
BankName Varchar(30),
Location varchar(40),
Address varchar(40),
City Varchar(40),
TotalCapacityUnits INT(40),
CONSTRAINT FK_Nmber  FOREIGN KEY (ContactID) REFERENCES ContactNumber(contactID),
CONSTRAINT FK_DonationEvent FOREIGN KEY (DonationID) REFERENCES DonationEvent(DonationID)
);

create table ContactNumber(
ContactID int Primary key, 
Contactnumber Varchar(11)
);
CREATE TABLE BloodType (
Quantatity_Available INT,
PRIMARY KEY(Blood_Type),
Blood_Type ENUM('A+' , 'A-', 'B+','B-', 'AB+','AB-','O+','O-') NOT NULL DEFAULT 'Pending', 
LastUpdate Date, 
CONSTRAINT FK_BloodBank FOREIGN KEY (BankID) REFERENCES BloodBank(BankID)
);

